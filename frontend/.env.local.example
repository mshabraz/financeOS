# Dev on LAN — copy to frontend/.env.local when accessing from another device

# Proxy target for Vite dev server (machine running the backend)
VITE_API_PROXY=http://192.168.1.42:3001

# Or set full API URL (overrides relative /api)
# VITE_API_URL=http://192.168.1.42:3001/api

VITE_HOST=0.0.0.0
VITE_PORT=5173
