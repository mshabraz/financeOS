# FinanceOS — App Server (second Windows PC on LAN)
# Copy to C:\FinanceOS\app\.env (never commit the real .env)

HOST=0.0.0.0
PORT=3001
FRONTEND_PORT=5173

LAN_MODE=true
SERVE_FRONTEND=true
AUTH_ENABLED=true
MDNS_ENABLED=false

HTTPS=false
COOKIE_SECURE=false
TRUST_PROXY=false

# Persistent data OUTSIDE the git repo
DATA_DIR=C:/FinanceOS/data

# Required on App Server — generate a long random string
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Cloudflare tunnel — trust X-Forwarded-* from the tunnel proxy
TRUST_PROXY=true

# ── Open banking (Enable Banking production) ─────────────────────────────────
OPEN_BANKING_PROVIDER=enable_banking
ENABLE_BANKING_APP_ID=335ee7d1-91fe-4996-9998-9736b8b5c140
ENABLE_BANKING_PRIVATE_KEY_PATH=C:/FinanceOS/data/certs/enable-banking-private.pem
OPEN_BANKING_REDIRECT_URL=https://butter-heading-buffer-low.trycloudflare.com/api/open-banking/callback

# NODE_ENV=production
