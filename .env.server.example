# FinanceOS — App Server (second Windows PC on LAN)
# Copy to C:\FinanceOS\app\.env (never commit the real .env)

HOST=0.0.0.0
PORT=3001
FRONTEND_PORT=5173

LAN_MODE=true
SERVE_FRONTEND=true
AUTH_ENABLED=true
MDNS_ENABLED=false

HTTPS=false
COOKIE_SECURE=false
TRUST_PROXY=false

# Persistent data OUTSIDE the git repo
DATA_DIR=C:/FinanceOS/data

# Required on App Server — generate a long random string
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# NODE_ENV=production
