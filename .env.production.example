# FinanceOS — production / Docker / LAN server template
# Copy to .env on the server (never commit the real .env file).

NODE_ENV=production

HOST=0.0.0.0
PORT=3001

# Single-port mode: backend serves built frontend
SERVE_FRONTEND=true
LAN_MODE=true
AUTH_ENABLED=true

# Required in production — use a long random string (32+ chars)
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# HTTPS (recommended on LAN if phones block mixed content)
HTTPS=false
COOKIE_SECURE=false
# After: npm run certs
# TLS_KEY_PATH=backend/data/certs/key.pem
# TLS_CERT_PATH=backend/data/certs/cert.pem

# Persistent data (Docker volume mount point)
DATA_DIR=backend/data

# Behind nginx/Caddy/Traefik
TRUST_PROXY=false

# Optional
MDNS_ENABLED=false
YAHOO_TLS_RELAXED=false
CORS_ORIGINS=
