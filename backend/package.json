{
  "name": "finance-manager-backend",
  "version": "1.0.0",
  "description": "Local-first personal finance manager backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:lan": "cross-env LAN_MODE=true AUTH_ENABLED=true SERVE_FRONTEND=true HOST=0.0.0.0 node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:lan": "cross-env LAN_MODE=true AUTH_ENABLED=true HOST=0.0.0.0 nodemon src/index.js",
    "certs": "node ../scripts/generate-certs.mjs",
    "db:migrate": "node ../scripts/migrate.mjs",
    "db:backup": "node ../scripts/backup-db.mjs",
    "db:status": "node ../scripts/migrate.mjs --status"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bonjour-service": "^1.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "iconv-lite": "^0.6.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "sql.js": "^1.12.0",
    "undici": "^8.3.0",
    "winston": "^3.11.0",
    "yahoo-finance2": "^3.14.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0"
  }
}
