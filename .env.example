# FinanceOS — local development configuration
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  copy .env.example .env   (Windows)
#                     cp .env.example .env     (Mac/Linux)
# 2. Edit .env for your machine (optional — defaults work for localhost)
# 3. NEVER commit .env — it may contain secrets
#
# The backend loads .env from project root OR backend/.env (root wins if both exist).

# ── Network ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3001
FRONTEND_PORT=5173

# LAN: phones/tablets on same Wi‑Fi (see docs/LAN.md)
LAN_MODE=true
SERVE_FRONTEND=false

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_ENABLED=true
# SESSION_SECRET=optional-fixed-secret-for-dev-only

# ── HTTPS (optional) ─────────────────────────────────────────────────────────
HTTPS=false
COOKIE_SECURE=false
# Run once: npm run certs
TLS_KEY_PATH=backend/data/certs/key.pem
TLS_CERT_PATH=backend/data/certs/cert.pem

# ── Data (SQLite, auth, backups) — stays on YOUR disk, not in Git ───────────
DATA_DIR=backend/data

# ── CORS / proxy ─────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://192.168.1.10:5173
TRUST_PROXY=false
MDNS_ENABLED=false

# ── Market data (investments) ────────────────────────────────────────────────
# YAHOO_TLS_RELAXED=true

# ── Node ─────────────────────────────────────────────────────────────────────
# NODE_ENV=development
