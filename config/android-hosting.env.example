# FinanceOS — Android phone hosting (copy to ~/financeos/app/.env in Phase 1)
# Independent from PC production — never point DATA_DIR at C:\FinanceOS\data

HOST=0.0.0.0
PORT=3001
LAN_MODE=true
SERVE_FRONTEND=true
AUTH_ENABLED=true

# Phone-local data only (Termux path example)
DATA_DIR=/data/data/com.termux/files/home/financeos/data

# Optional: reduce background load during trial (PC still runs OB until cutover)
# OPEN_BANKING_AUTO_SYNC_ON_LOGIN=false

# Node memory hint for 4GB phone (optional)
# NODE_OPTIONS=--max-old-space-size=512
